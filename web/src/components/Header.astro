---
const baseUrl = import.meta.env.BASE_URL;
---

<header class="site-header">
  <a href="#studio" class="skip-link">Skip to studio</a>
  <div class="header-inner mx-auto max-w-6xl px-6">
    <a href={baseUrl} class="brand-lockup" aria-label="AXOM_VID home">
      <svg class="brand-mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <polygon points="50,6 72.4,45.5 58.1,58.1 65.3,44 50,21.3 34.7,44 41.9,58.1 27.6,45.5" />
        <polygon points="50,56.4 57.2,63.3 50,70.2 42.8,63.3" />
        <polygon points="22.88,54.34 28.97,56.55 6.83,94 0,93.1" />
        <polygon points="77.12,54.34 71.03,56.55 93.17,94 100,93.1" />
      </svg>
      <span class="brand-type" aria-hidden="true">
        <svg class="brand-wordmark" viewBox="0 0 410 92" focusable="false">
          <path d="M22 82 52 20 82 82 M122 20l56 62 M178 20l-56 62 M332 82V20l25 39 25-39v62" />
          <circle cx="251" cy="51" r="31" />
        </svg>
        <span class="brand-suffix">_VID</span>
      </span>
    </a>
    <a class="header-back" href="https://www.axom.info/" target="_blank" rel="noopener noreferrer" aria-label="Visit AXOM, opens in a new tab">
      AXOM <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
