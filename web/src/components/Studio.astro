---
// The core interactive area: image upload, prompt, generate button, video preview, history.
//
// The structure is intentionally plain HTML with data-* hooks. The client-side
// behavior lives in `src/scripts/studio.ts`, attached at the bottom of this file
// via `<script>`. Astro will bundle and ship that script automatically.
//
// We could reach for React or another framework here, but for one page with one
// form, vanilla TS is lighter, faster to load, and easier for a learner to read
// top to bottom without framework noise.
const baseUrl = import.meta.env.BASE_URL;
const assetBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
---

<section class="studio mx-auto max-w-6xl px-6 pb-16 sm:pb-24" id="studio" aria-label="Video studio">
  <div class="studio-grid grid lg:grid-cols-2 gap-7 lg:gap-8">
    <!-- LEFT COLUMN: inputs -->
    <div class="space-y-5">
      <div>
        <label for="source-image" class="field-label block mb-2">
          <span class="step-index">01</span> Source image
        </label>
        <!-- The dropzone is a label so clicking it opens the file picker.
             The actual <input> is hidden but still keyboard-accessible. -->
        <label for="source-image" class="dropzone group" data-dropzone>
          <input
            id="source-image"
            type="file"
            name="source-image"
            aria-label="Choose a source image"
            aria-describedby="source-image-help"
            accept="image/png, image/jpeg, image/webp"
            class="sr-only"
            data-file-input
          />
          <div class="dropzone-empty text-center px-6 py-9" data-dropzone-empty>
            <svg viewBox="0 0 24 24" class="upload-icon w-10 h-10 mx-auto" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 7.5m0 0L7.5 12M12 7.5v9" />
            </svg>
            <p class="mt-3 dropzone-title">
              Drop an image or <span class="browse-word">browse</span>
            </p>
            <p id="source-image-help" class="field-hint mt-1">PNG, JPG, or WEBP &middot; max 8 MB</p>
          </div>
          <!-- Preview shown after upload. Hidden until JS swaps it in. -->
          <img src={`${assetBase}favicon.svg`} data-dropzone-preview class="source-preview hidden max-h-[240px] sm:max-h-[280px] object-contain" alt="Selected source image preview" />
        </label>
        <button type="button" data-remove-image class="btn-ghost hidden mt-2 text-xs" aria-label="Remove source image">Remove image</button>
      </div>

      <div>
        <label for="prompt" class="field-label block mb-2">
          <span class="step-index">02</span> Motion prompt
        </label>
        <textarea
          id="prompt"
          name="prompt"
          rows="3"
          aria-describedby="prompt-help"
          data-prompt
          class="prompt-input w-full px-4 py-3 resize-y"
          placeholder="A gentle camera pan to the right as the leaves drift…"
        ></textarea>
        <p id="prompt-help" class="field-hint mt-2">
          Describe motion and camera, not just what's in the frame. The model already sees the image.
        </p>
      </div>

      <div class="space-y-2">
        <label for="render-engine" class="field-label block">Render engine</label>
        <select id="render-engine" data-engine
          class="prompt-input w-full px-4 py-3">
          <option value="local">Local Mac · no daily limit · no API fees</option>
          <option value="shared">Shared cloud GPU · daily allowance</option>
        </select>
        <p data-engine-help class="field-hint">
          Local renders run on your own Mac with Phosphene installed.
        </p>
        <p data-local-open class="hidden field-hint">
          Start the local studio on your Mac, then
          <a href="http://127.0.0.1:8765/AXOM_VID/" target="_blank" rel="noopener noreferrer"
             class="underline">open your local studio</a>.
          The public website cannot use your Mac GPU remotely.
        </p>
        <button data-local-check type="button" class="btn-ghost hidden text-xs">
          Check local engine
        </button>
      </div>

      <details class="advanced-panel">
        <summary class="advanced-summary cursor-pointer select-none px-4 py-3">
          Advanced options
        </summary>
        <div class="px-4 pb-4 pt-1 space-y-4">
          <div>
            <label for="duration" class="range-label flex items-center justify-between">
              <span>Duration</span>
              <span data-duration-value class="range-value font-mono">1.5s</span>
            </label>
            <input
              id="duration"
              name="duration"
              aria-describedby="duration-help"
              type="range"
              min="0.5" max="4.5" step="0.1" value="1.5"
              data-duration
              class="range-control w-full"
            />
            <select id="local-duration" data-local-duration
              class="prompt-input hidden w-full px-3 py-3">
              <optgroup label="Single render">
                <option value="3">3 seconds · fastest</option>
                <option value="5">5 seconds</option>
                <option value="7">7 seconds</option>
                <option value="10">10 seconds · more memory</option>
              </optgroup>
              <optgroup label="Chained One Take · multiple GPU passes">
                <option value="30">30 seconds · chained</option>
                <option value="45">45 seconds · chained</option>
                <option value="60">1 minute · chained</option>
                <option value="90">1.5 minutes · chained</option>
                <option value="120">2 minutes · chained</option>
              </optgroup>
            </select>
            <p id="duration-help" data-duration-help class="field-hint mt-1">Shorter clips usually finish sooner on a shared GPU.</p>
          </div>
          <div>
            <label for="steps" class="range-label flex items-center justify-between">
              <span>Inference steps</span>
              <span data-steps-value class="range-value font-mono">3</span>
            </label>
            <input
              id="steps"
              name="steps"
              aria-describedby="steps-help"
              type="range"
              min="1" max="12" step="1" value="3"
              data-steps
              class="range-control w-full"
            />
            <p id="steps-help" data-steps-help class="field-hint mt-1">More steps may improve detail, but take longer.</p>
          </div>
        </div>
      </details>

      <div data-local-settings class="hidden space-y-4 rounded-xl border border-white/10 p-4">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="local-batch" class="field-label block mb-2">Number of generations</label>
            <select id="local-batch" data-local-batch class="prompt-input w-full px-3 py-2">
              <option value="1">1 render</option>
              <option value="2">2 variations</option>
              <option value="3">3 variations</option>
              <option value="4">4 variations</option>
              <option value="5">5 variations</option>
              <option value="6">6 variations</option>
            </select>
          </div>
          <div>
            <label for="local-quality" class="field-label block mb-2">Local quality</label>
            <select id="local-quality" data-local-quality class="prompt-input w-full px-3 py-2">
              <option value="quick">Quick · recommended for 18 GB</option>
              <option value="balanced">Balanced · more memory/time</option>
            </select>
          </div>
        </div>
        <div>
          <label for="local-variations" class="field-label block mb-2">Optional prompt variations</label>
          <textarea id="local-variations" rows="3" data-local-variations
            class="prompt-input w-full px-3 py-2 resize-y"
            placeholder="One distinct motion prompt per line, matching the number of generations. Leave empty to repeat the main prompt with random seeds."></textarea>
          <p class="field-hint mt-1" data-local-hint>
            Up to six jobs are queued one at a time, not rendered concurrently.
          </p>
        </div>
      </div>

      <div class="action-row flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:gap-3">
        <button type="button" data-generate class="btn-primary min-h-12 sm:min-h-0" disabled>
          <span class="pulse-dot hidden" data-spinner></span>
          <span data-button-label>Generate video</span>
        </button>
        <p class="status-line leading-snug sm:max-w-[24rem]" data-status role="status" aria-live="polite" aria-atomic="true">
          Add an image to start.
        </p>
      </div>
      <p data-quota class="quota-line" role="status" aria-live="polite">Checking render engine…</p>
    </div>

    <!-- RIGHT COLUMN: output -->
    <div class="space-y-5">
      <h2 class="field-label block">
        <span class="step-index">03</span> Result
      </h2>

      <!-- Mutually exclusive states managed by the studio script. -->
      <div class="result-stage overflow-hidden min-h-[240px] sm:min-h-[280px]">
        <div data-result-empty class="result-state grid place-items-center min-h-[240px] sm:min-h-[280px] px-6 py-8 text-center">
          <div>
            <div class="result-placeholder mx-auto mb-5" aria-hidden="true">
              <span></span><span></span><span></span>
              <svg viewBox="0 0 20 20" fill="none"><path d="m7 5 7 5-7 5V5Z" fill="currentColor" /></svg>
            </div>
            <p class="state-title">Your clip will appear here</p>
            <p class="state-detail mt-1 max-w-[28ch] mx-auto">Add an image and describe its motion to begin.</p>
          </div>
        </div>
        <div data-result-loading class="result-state hidden grid place-items-center min-h-[240px] sm:min-h-[280px] px-6 py-8">
          <div class="text-center">
            <div class="pulse-dot mx-auto mb-3"></div>
            <p data-loading-message class="state-title">Sending your image…</p>
            <p class="state-detail mt-2"><span data-loading-elapsed class="font-mono tabular-nums">0:00</span> elapsed · Shared GPUs may take a few minutes.</p>
            <button type="button" data-cancel class="btn-ghost mt-5">Stop waiting</button>
          </div>
        </div>
        <div data-result-error class="result-state hidden grid place-items-center min-h-[240px] sm:min-h-[280px] px-6 py-8 text-center">
          <div>
            <div class="error-mark mx-auto mb-4" aria-hidden="true">!</div>
            <h3 data-error-title class="state-title">Video generation stopped</h3>
            <p data-error-detail class="state-detail mt-2 max-w-[36ch] mx-auto">Your image and prompt are still here. You can try again.</p>
            <button type="button" data-retry class="btn-ghost mt-5">Try again</button>
          </div>
        </div>
        <video data-result-video controls playsinline aria-label="Generated video preview" class="result-video hidden w-full max-h-[420px] object-contain" preload="metadata"></video>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a data-download class="btn-ghost hidden" download>Download MP4</a>
        <button data-gif-download type="button" class="btn-ghost hidden">
          Download GIF
        </button>
      </div>
      <div data-gif-settings class="hidden grid gap-3 grid-cols-3">
        <div>
          <label for="gif-seconds" class="field-hint block mb-1">GIF length</label>
          <select id="gif-seconds" data-gif-seconds class="prompt-input w-full px-2 py-2">
            <option value="3">3s</option><option value="5">5s</option>
            <option value="10" selected>10s</option><option value="15">15s</option>
          </select>
        </div>
        <div>
          <label for="gif-width" class="field-hint block mb-1">Width</label>
          <select id="gif-width" data-gif-width class="prompt-input w-full px-2 py-2">
            <option value="320">320px</option><option value="480" selected>480px</option>
            <option value="640">640px</option>
          </select>
        </div>
        <div>
          <label for="gif-fps" class="field-hint block mb-1">GIF FPS</label>
          <select id="gif-fps" data-gif-fps class="prompt-input w-full px-2 py-2">
            <option value="8">8</option><option value="12" selected>12</option>
            <option value="15">15</option>
          </select>
        </div>
        <p class="field-hint col-span-3">GIF export uses FFmpeg on your Mac. Long clips export at most the first 15 seconds.</p>
      </div>

      <div data-local-queue class="hidden space-y-3">
        <div class="flex flex-wrap justify-between items-center gap-2">
          <h3 class="field-label">Local render queue</h3>
          <button type="button" data-queue-refresh class="btn-ghost text-xs">Refresh statuses</button>
        </div>
        <ul data-local-job-list class="grid gap-3"></ul>
      </div>

      <!-- In-session history. Cleared on reload, we deliberately don't persist
           anything to localStorage to keep this simple and private. -->
      <div data-history-wrap class="hidden">
        <p class="history-label mb-2">This session</p>
        <ul data-history class="flex gap-3 overflow-x-auto pb-1"></ul>
      </div>
    </div>
  </div>
</section>

<script>
  // Ship the studio's interaction logic. Astro bundles, minifies, and inlines
  // this for us, we don't have to wire up a separate build step.
  import "@/scripts/studio";
</script>
