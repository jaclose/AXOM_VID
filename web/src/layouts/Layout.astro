---
// Base layout shared by every page. Holds <head> metadata, fonts, theming,
// and the outer body shell. Pages slot their content into <slot />.
//
// Astro frontmatter (this code between the ---) runs on the server at build
// time. The HTML below is what ships to the browser.

import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // Pages can override the OG image. Defaults to the project's main social
  // card. Path is relative to the site's base URL.
  ogImage?: string;
}

const {
  title = "AXOM_VID — Turn a still frame into motion",
  description = "AXOM_VID turns a source image and a motion prompt into a short Wan 2.2 video. Preview the result, refine the direction, and download your clip.",
  ogImage = "axom-vid-og.png",
} = Astro.props;

// The base path is read from Astro's config (`/AXOM_VID` in production,
// `/` locally). Always use Astro.url.pathname or import.meta.env.BASE_URL
// when linking to internal assets so paths work in both contexts.
const baseUrl = import.meta.env.BASE_URL;

// Build absolute URLs for OG tags. Social platforms ignore relative paths,
// so this matters even for tiny projects. SITE is set in astro.config.mjs.
const siteOrigin = Astro.site?.origin ?? "https://jaclose.github.io";
const pagePath = Astro.url.pathname;
const canonical = new URL(pagePath, siteOrigin).toString();
const absoluteOg = new URL(`${baseUrl}${ogImage}`, siteOrigin).toString();

// JSON-LD structured data. Google reads this to render rich results in search,
// and it's a cheap, low-risk win for any public site. We declare the project
// as a SoftwareApplication so it can pick up the right icon and price.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "AXOM_VID",
  url: canonical,
  description,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any (web)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Jafar Dabbagh", url: "https://www.axom.info/" },
  isBasedOn: "https://github.com/IgorCSIS/nifty-vid",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0d0d0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#eee7da" media="(prefers-color-scheme: light)" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Keywords help niche search engines and AI crawlers even though Google
         mostly ignores them. They cost nothing and occasionally help. -->
    <meta
      name="keywords"
      content="AXOM_VID, image to video, Wan 2.2, animate an image, AI video generator, motion prompt"
    />
    <meta name="author" content="Jafar Dabbagh" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Favicons. The SVG covers modern browsers; the PNG is a fallback for
         older platforms and for social cards that prefer raster. -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${baseUrl}axom-icon-512.png`} />

    <!-- Open Graph (Facebook, LinkedIn, Slack, Discord). The image is the
         single most important tag here: a good card more than doubles
         click-through on shared links. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AXOM_VID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AXOM_VID: A still frame, set in motion" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X. summary_large_image gives the wide hero card. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />
    <meta name="twitter:image:alt" content="AXOM_VID: A still frame, set in motion" />

    <!-- JSON-LD structured data for search engine rich results. set:html is
         the Astro escape hatch that prevents the JSON from being HTML-escaped. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
