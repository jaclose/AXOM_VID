---
// Single-page app. The whole site is this one page, by design.
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Studio from "@/components/Studio.astro";
---

<Layout>
  <Header />
  <main>
    <Hero />
    <Studio />
  </main>
  <footer class="site-footer mt-12">
    <div class="footer-inner mx-auto max-w-6xl px-6 py-8 flex flex-col gap-2 sm:flex-row sm:justify-between">
      <span>AXOM_VID / an image-to-video study</span>
      <span>Adapted from <a href="https://github.com/IgorCSIS/nifty-vid" target="_blank" rel="noopener noreferrer">NiftyVid by Igor Lima</a> · MIT licensed</span>
    </div>
  </footer>
</Layout>
